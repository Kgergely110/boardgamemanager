// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Players who can log in or just be referenced in play logs
model Player {
  id        String   @id @default(uuid())
  username  String?  @unique
  email     String?  @unique
  password  String? // null if player is only referenced, not a login user
  fullName  String
  avatar    String? // URL or file path
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  playLogs                PlayLogParticipant[]
  gameRatings             GameRating[]
  ongoingGameParticipants OngoingGameParticipant[]
}

// Container types for organizing games (shelf, box, etc.)
model Shelf {
  id           String   @id @default(uuid())
  name         String
  type         String // "shelf", "cupboard", "desk", "cabinet", etc.
  color        String? // hex color or color name
  cabinetColor String?
  position     Int // display order
  shelfCount   Int      @default(1) // number of shelves/compartments
  width        Int? // in cm
  height       Int? // in cm
  depth        Int? // in cm
  description  String?
  imageUrl     String? // photo of the shelf
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  games Game[]

  @@index([position])
}

// Tags/Labels for games
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String? // for UI
  icon      String? // emoji or icon name
  createdAt DateTime @default(now())

  // Relations
  games        Game[]
  wikiEntries  WikiEntry[]
  ambienceSets AmbienceSet[] @relation("AmbienceSetTags")

  @@index([name])
}

// Board games
model Game {
  id          String  @id @default(uuid())
  name        String
  maker       String // publisher/designer
  releaseYear Int?
  description String?

  // Physical properties
  imageUrl    String? // URL or file path
  orientation String  @default("vertical") // "vertical", "horizontal", "flat", "stacked"

  // Game properties
  minPlayers Int?
  maxPlayers Int?
  ageLimit   Int?
  playTime   Int? // in minutes

  // Location
  shelfId      String
  shelf        Shelf        @relation(fields: [shelfId], references: [id], onDelete: Restrict)
  shelfNumber  Int          @default(1)
  position     Int // position on shelf
  stackedOnId  String?
  stackedOn    Game?        @relation("GameStack", fields: [stackedOnId], references: [id], onDelete: SetNull)
  stackedGames Game[]       @relation("GameStack")
  deletedGame  DeletedGame?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tags         Tag[]
  wikiEntries  WikiEntry[]
  playLogs     PlayLog[]
  ongoingGames OngoingGame[]
  documents    GameDocument[]
  ratings      GameRating[]
  awards       GameAward[]
  ambienceSets AmbienceSet[]  @relation("AmbienceSetGames")

  @@index([name])
  @@index([shelfId])
  @@index([maker])
  @@index([stackedOnId])
}

model DeletedGame {
  id          String   @id @default(uuid())
  gameId      String   @unique
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name        String
  maker       String
  releaseYear Int?
  deletedAt   DateTime @default(now())

  @@index([name])
}

// Rules and other documents (markdown)
model GameDocument {
  id        String   @id @default(uuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  title     String // "Rules", "Missions", etc.
  content   String // markdown content
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
}

model GameRating {
  id                String   @id @default(uuid())
  gameId            String
  game              Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  overall           Int
  luckFactor        Int?
  strategyDepth     Int?
  socialDeduction   Int?
  logicalDeduction  Int?
  playerInteraction Int?
  complexity        Int?
  comment           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([gameId, playerId])
  @@index([playerId])
}

model GameAward {
  id            String   @id @default(uuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name          String
  category      String?
  year          Int?
  normalizedKey String
  createdAt     DateTime @default(now())

  @@unique([gameId, normalizedKey])
  @@index([gameId, year])
}

model AmbienceSet {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  games Game[]         @relation("AmbienceSetGames")
  tags  Tag[]          @relation("AmbienceSetTags")
  links AmbienceLink[]

  @@index([name])
}

model AmbienceLink {
  id            String      @id @default(uuid())
  ambienceSetId String
  ambienceSet   AmbienceSet @relation(fields: [ambienceSetId], references: [id], onDelete: Cascade)
  title         String
  kind          String
  uri           String
  position      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([ambienceSetId, position])
}

// Play session log
model PlayLog {
  id          String     @id @default(uuid())
  gameId      String?
  game        Game?      @relation(fields: [gameId], references: [id], onDelete: Restrict)
  guestGameId String?
  guestGame   GuestGame? @relation(fields: [guestGameId], references: [id], onDelete: Restrict)

  playedAt DateTime // when the game was played
  duration Int? // in minutes
  location String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants PlayLogParticipant[]

  @@index([gameId])
  @@index([guestGameId])
  @@index([playedAt])
  @@index([duration])
}

model GuestGame {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  playLogs     PlayLog[]
  ongoingGames OngoingGame[]

  @@index([name])
}

model OngoingGame {
  id                    String     @id @default(uuid())
  gameId                String?
  game                  Game?      @relation(fields: [gameId], references: [id], onDelete: Restrict)
  guestGameId           String?
  guestGame             GuestGame? @relation(fields: [guestGameId], references: [id], onDelete: Restrict)
  startedAt             DateTime   @default(now())
  pausedAt              DateTime?
  pausedDurationSeconds Int        @default(0)
  location              String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  participants OngoingGameParticipant[]

  @@index([gameId])
  @@index([guestGameId])
  @@index([startedAt])
}

model OngoingGameParticipant {
  id            String      @id @default(uuid())
  ongoingGameId String
  ongoingGame   OngoingGame @relation(fields: [ongoingGameId], references: [id], onDelete: Cascade)
  playerId      String?
  player        Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)
  displayName   String
  createdAt     DateTime    @default(now())

  @@unique([ongoingGameId, playerId])
  @@index([ongoingGameId])
  @@index([playerId])
}

// Join table for play log participants
model PlayLogParticipant {
  id          String  @id @default(uuid())
  playLogId   String
  playLog     PlayLog @relation(fields: [playLogId], references: [id], onDelete: Cascade)
  playerId    String?
  player      Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  displayName String

  score     Int?
  placement Int? // 1st, 2nd, 3rd, etc. - null means unranked
  createdAt DateTime @default(now())

  @@unique([playLogId, playerId])
  @@index([playLogId])
  @@index([playLogId, placement])
  @@index([playerId])
}

model WikiCategory {
  id        String   @id @default(uuid())
  title     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries WikiEntry[]
}

model WikiEntry {
  id           String       @id @default(uuid())
  title        String       @map("term")
  content      String       @map("definition")
  categoryId   String
  category     WikiCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedTerms String[]     @default([])
  imageUrl     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tags  Tag[]
  games Game[]

  @@unique([categoryId, title])
  @@index([categoryId])
  @@index([title])
  @@map("GlossaryEntry")
}
